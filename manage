<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Map Painter (ラベル編集・サイズ変更対応)</title>
  <style>
    body { margin: 0; font-family: sans-serif; }
    svg { width: 100%; height: auto; display: block; background: #e8eef6; }

    .prov { fill: #ffffff; stroke: #111; stroke-width: 1; cursor: pointer; }
    .prov:hover { opacity: 0.85; }

    #ui { padding: 12px; display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
    #nameInput { padding: 6px 8px; min-width: 220px; }
    .prov.selected { fill: #ff00003f !important; opacity: 0.9; }
    .label {
      font-weight: 800;
      fill: #fff;                /* 文字色：白 */
      stroke: #000;              /* 縁：黒 */
      stroke-width: 6px;         /* 縁の太さ */
      paint-order: stroke fill;  /* 縁→塗りの順 */
      user-select: none;
      pointer-events: auto;      /* クリックやドラッグを受ける */
      cursor: move;              /* ドラッグ可能に見せる */
    }
    .labels-hidden .label { display: none; }

    /* 小さめのUIスタイル */
    #labelEditor { display:flex; gap:6px; align-items:flex-start; }
    #labelText { width:360px; height:56px; padding:6px; font-size:14px; }
    .tiny { padding:6px 8px; }
  </style>
</head>
<body>

<div id="ui">
  <input id="nameInput" placeholder="国名（例：ブラジル）" />

  <input type="color" id="colorInput" value="#ff4444" title="国の色" style="cursor: pointer;" />
  <select id="countrySelect">
    <option value="">（国を選択）</option>
  </select>

  <button id="createCountryBtn">新規作成</button>
  <button id="applyToCountryBtn">選択プロビを国に反映（追加/削除）</button>
  <button id="addFreeLabelBtn">ラベル追加</button>
  <button id="exportBtn">データを書き出す</button>
  <input type="file" id="importFile" accept="application/json" />
  <button id="importBtn">map-data.json を読み込む</button>
  <input id="ghToken" type="password" placeholder="GitHub token（fine-grained PAT）">
  <button id="publishBtn">公開（map-data.jsonをGitHubへ反映）</button>
  <span id="publishStatus"></span>

  <label>
    <input type="checkbox" id="toggleLabels" checked />
    国名を表示
  </label>

  <span id="status"></span>
</div>

<div id="ui" style="border-top:1px solid #ddd; padding-top:8px;">
  <div id="labelEditor">
    <textarea id="labelText" placeholder="選択中の国ラベル（改行は Enter）"></textarea>
    <div style="display:flex; flex-direction:column; gap:6px;">
      <button id="applyLabelTextBtn" class="tiny">ラベルに反映（改行可）</button>
      <button id="resetLabelPosBtn" class="tiny">ラベルを中央へ移動</button>
      <label style="font-size:12px"><input type="checkbox" id="lockLabelCenter"> 中央に固定（自動配置）</label>

      <div style="display:flex; gap:6px; align-items:center; margin-top:6px;">
        <label style="font-size:12px;">文字サイズ</label>
        <input type="range" id="labelSize" min="8" max="72" value="18" />
        <span id="labelSizeVal">18</span>px
        <button id="applySizeBtn" class="tiny" style="margin-left:6px;">サイズ適用</button>
      </div>
    <div style="font-size:12px; color:#555; max-width:260px;">ラベルはドラッグで移動可能です。ラベル編集後は「ラベルに反映」を押してください。</div>
    </div>
  </div>
</div>

